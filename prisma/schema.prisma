generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
  binaryTargets   = ["native", "rhel-openssl-1.0.x"]
}

datasource db {
  provider     = "postgres"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model User {
  id                   String                 @id @default(cuid())
  name                 String?
  email                String                 @unique
  password             String?
  role                 String?                @default("worker")
  emailVerified        Boolean?               @default(false)
  suspended            Boolean?               @default(false)
  referralCode         String?
  referred             Boolean                @default(false)
  special              Boolean?               @default(false)
  image                String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  accounts             Account[]
  sessions             Session[]
  verification         Verification[]
  reset                Reset[]
  updateEmailVerify    UpdateEmailVerify[]
  updatePasswordVerify UpdatePasswordVerify[]

  workers       Workers[]
  employers     Employers[]
  Admin         Admin?
  ChatUser      ChatUser?
  userReferrals UserReferrals[]
}

model Verification {
  verifyToken        String   @unique
  verifyTokenExpiry  DateTime
  email              String   @unique
  name               String
  role               String
  referrerUniqueCode String?
  referrerUserId     String?
  referrerEmail      String?
  referrerName       String?

  user User @relation(fields: [email], references: [email], onDelete: Cascade)
}

model Reset {
  resetToken       String   @unique
  resetTokenExpiry DateTime
  email            String   @unique
  role             String?

  user User @relation(fields: [email], references: [email], onDelete: Cascade)
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String?
  provider          String?
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationRequest {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Workers {
  id          String   @id @default(cuid())
  workerEmail String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user                  User                    @relation(fields: [workerEmail], references: [email], onDelete: Cascade, onUpdate: Cascade)
  about                 About[]
  experience            Experience[]
  secondaryEducation    SecondaryEducation[]
  tertiaryEducation     TertiaryEducation[]
  workerBio             WorkerBio[]
  workerDesires         WorkerDesires[]
  workerContact         WorkerContact[]
  Resume                Resume[]
  Skills                Skills[]
  CertificationLicense  CertificationLicense[]
  Award                 Award[]
  Language              Language[]
  Application           Application[]
  SavedJobs             SavedJobs[]
  HelpWorker            HelpWorker[]
  ReportJob             ReportJob[]
  WorkerCreditPoints    WorkerCreditPoints[]
  WorkerRequestRedeem   WorkerRequestRedeem[]
  ContactWorker         ContactWorker[]
  EmployerContactWorker EmployerContactWorker[]
  CareerWizard          CareerWizard[]
  AcceptToBeAssessed    AcceptToBeAssessed[]
  SubmitTest            SubmitTest[]
}

model Employers {
  id            String   @id @default(cuid())
  employerEmail String   @unique
  jobPosition   String?
  bgColor       String   @default("#bae6fd")
  bgTextColor   String   @default("#075985")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [employerEmail], references: [email], onDelete: Cascade, onUpdate: Cascade)

  job                       Job[]
  company                   Company[]
  HelpEmployer              HelpEmployer[]
  EmployerMessageCandidate  EmployerMessageCandidate[]
  ContactEmployer           ContactEmployer[]
  AccountBalance            AccountBalance[]
  EmployerContactWorker     EmployerContactWorker[]
  Payment                   Payment[]
  TopUp                     TopUp[]
  PurchaseJobPlan           PurchaseJobPlan[]
  EmployerRequestAssessment EmployerRequestAssessment[]
  PickAssessCandidate       PickAssessCandidate[]
  SubmitDemo                SubmitDemo[]
}

model ChatUser {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [email], references: [email], onDelete: Cascade, onUpdate: Cascade)
}

model Admin {
  id                     String                   @id @default(cuid())
  adminEmail             String                   @unique
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  user                   User                     @relation(fields: [adminEmail], references: [email], onDelete: Cascade, onUpdate: Cascade)
  ContactEmployer        ContactEmployer[]
  Blogs                  Blogs[]
  AdminProfile           AdminProfile[]
  EmailWorker            EmailWorker[]
  EmailWorkerOnJobSkills EmailWorkerOnJobSkills[]
  EmailWorkerGeneral     EmailWorkerGeneral[]
  ContactWorker          ContactWorker[]
  EmployerPlans          EmployerPlans[]
  EmailRound             EmailRound[]
  EmailLog               EmailLog[]
}

model UserReferrals {
  id              String  @id @default(cuid())
  userId          String
  fullName        String
  email           String
  inviteeEmail    String
  inviteeName     String?
  redeemed        Boolean @default(false)
  credit          Int     @default(0)
  uniqueCode      String
  myRole          String
  inviteeViewID   String?
  recurringViewID Boolean @default(false)
  hide            Boolean @default(false)
  invitationCode  String?
  joined          Boolean @default(false)
  approved        Boolean @default(false)
  failed          Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
}

model Job {
  id                          String    @id @default(cuid())
  job_id                      Int       @unique
  userId                      String
  isEmployerID                String
  createdByName               String?
  jobFormNonRegisteredCompany Boolean   @default(false)
  unregisteredKnown           Boolean   @default(false)
  adminCreatingCompanyName    String?
  company_description         String?   @db.Text
  companyCategory             String?
  companyEmail                String?
  companyWebsite              String?
  companyId                   String
  company_name                String
  companyLogo                 String?
  adminPosted                 Boolean   @default(false)
  job_type                    String?
  seniority                   String?
  subCategory                 String?
  job_title                   String
  summaryDescription          String
  job_description             String    @db.Text
  responsibilities            String?   @db.Text
  requirement                 String?   @db.Text
  personal_skills             String[]  @default([])
  experience                  String?   @db.Text
  numberOfPositions           String?
  possible_pay                String?
  category                    String?
  county                      String?
  published                   Boolean?  @default(false)
  deadline                    DateTime?
  filled                      Boolean?  @default(false)
  rankTop                     Boolean   @default(false)
  platform                    String?
  emailPlatform               String?
  linkPlatform                String?
  otherPlatform               String?
  ownPlatformMethod           String?
  applied                     Int       @default(0)
  archived                    Boolean   @default(false)
  emailed                     Boolean   @default(false)
  experienceDesired           String?
  address                     String?
  academic                    String?
  benefits                    String[]  @default([])
  instructions                String?
  academicDesired             String?
  addAssessment               Boolean   @default(false)
  assessmentOneID             String?
  assessmentTwoID             String?
  bonusTestID                 String?
  logo2                       String?   @default("https://res.cloudinary.com/dgirxstq9/image/upload/v1735059678/New_Logo_aur3j1_fmyw0a.png")
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  employer    Employers     @relation(fields: [isEmployerID], references: [id], onDelete: Cascade, onUpdate: Cascade)
  Application Application[]
  SavedJobs   SavedJobs[]

  @@index([companyId])
  @@index([isEmployerID])
}

model EmailRound {
  id        String   @id @default(uuid())
  isAdminID String
  round     Int      @unique
  emails    String[]
  allUsers  String[]
  createdAt DateTime @default(now())

  admin Admin @relation(fields: [isAdminID], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([isAdminID])
}

model EmailLog {
  id        String   @id @default(uuid())
  adminId   String
  createdAt DateTime @default(now())

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
}

model UnregisteredCompany {
  id                 String   @id @default(cuid())
  companyName        String
  companyDescription String?
  companyCategory    String?
  companyWebsite     String?
  companyEmail       String?
  logo               String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model LastRequestJobsIndex {
  id        String   @id @default(cuid())
  number    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LastRequestBlogsIndex {
  id        String   @id @default(cuid())
  number    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model stackChats {
  id        String   @id @default(cuid())
  userId    String
  messageID String?
  likes     Int      @default(0)
  role      String
  name      String
  subject   String
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProfileView {
  id           String   @id @default(cuid())
  bioID        String
  userId       String?
  workerUserID String
  viewed       Boolean  @default(false)
  views        Int      @default(0)
  isEmployerID String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bio WorkerBio @relation(fields: [bioID], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([bioID])
}

model SavedJobs {
  id         String   @id @default(cuid())
  isWorkerID String
  userId     String
  saved      Boolean  @default(false)
  jobID      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  worker Workers @relation(fields: [isWorkerID], references: [id], onDelete: Cascade, onUpdate: Cascade)
  job    Job     @relation(fields: [jobID], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([isWorkerID])
  @@index([jobID])
}

model WorkerBio {
  id               String   @id @default(cuid())
  userId           String   @unique
  isWorkerID       String
  name             String
  county           String?
  thumbUp          Int?     @default(0)
  checked          Boolean  @default(false)
  suspended        Boolean  @default(false)
  viewCounts       Int?     @default(0)
  gender           String?
  citizen          String?
  identityNumber   String?
  yearOfBirth      String?
  currentJobTitle  String?
  employmentType   String?
  highestEducation String?
  profilePic       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  worker      Workers       @relation(fields: [isWorkerID], references: [id], onDelete: Cascade, onUpdate: Cascade)
  ProfileView ProfileView[]
  ThumsUp     ThumbsUp[]

  @@index([isWorkerID])
}

model ThumbsUp {
  id           String   @id @default(cuid())
  isEmployerID String
  userId       String
  liked        Boolean  @default(false)
  bioID        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workerBio WorkerBio @relation(fields: [bioID], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([bioID])
}

model WorkerDesires {
  id                       String   @id @default(cuid())
  userId                   String   @unique
  isWorkerID               String
  category                 String?
  yearsOfExperience        String?
  availability             String?
  searchable               Boolean  @default(false)
  noEmails                 Boolean  @default(false)
  willingToRelocateWithin  String?
  currentRemuneration      String?
  currentRemunerationTerms String?
  desiredRemuneration      String?
  desiredRemunerationTerms String?
  desiredEmploymentType    String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  worker Workers @relation(fields: [isWorkerID], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([isWorkerID])
}

model EmailWorker {
  id                String   @id @default(cuid())
  userId            String
  isAdminID         String
  reason            String
  subject           String
  recipientsEmail   String[] @default([])
  toEmailJobIDs     String[] @default([])
  recipientsUserIds String[] @default([])
  emailBody         String   @db.Text
  jobCategory       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  admin Admin @relation(fields: [isAdminID], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([isAdminID])
}

model EmailWorkerOnJobSkills {
  id             String   @id @default(cuid())
  userId         String
  isAdminID      String
  reason         String
  subject        String
  message        String   @db.Text
  emailedUserIds String[] @default([])
  emailedJobIds  String[] @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  admin Admin @relation(fields: [isAdminID], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([isAdminID])
}

model EmailWorkerGeneral {
  id             String   @id @default(cuid())
  userId         String
  isAdminID      String
  reason         String
  subject        String
  message        String   @db.Text
  emailedUserIds String[] @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  admin Admin @relation(fields: [isAdminID], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([isAdminID])
}

model WorkerContact {
  id             String   @id @default(cuid())
  userId         String   @unique
  isWorkerID     String
  email          String
  phone          String?
  secondaryPhone String?
  secondaryEmail String?
  postal         String?
  zip            String?
  town           String?
  county         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  worker Workers @relation(fields: [isWorkerID], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([isWorkerID])
}

model HelpWorker {
  id         String   @id @default(cuid())
  userId     String
  isWorkerID String
  role       String
  fullName   String
  priority   String
  subject    String
  message    String
  hide       Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  worker Workers @relation(fields: [isWorkerID], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([isWorkerID])
}

model HomepageContact {
  id        String   @id @default(cuid())
  fullName  String
  email     String
  subject   String
  message   String
  ipAddress String?
  location  String?
  viewID    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model homepageSubscribe {
  id        String   @id @default(cuid())
  email     String
  ipAddress String?
  location  String?
  viewID    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HelpEmployer {
  id           String   @id @default(cuid())
  userId       String
  isEmployerId String
  fullName     String
  role         String
  message      String
  priority     String
  subject      String
  hide         Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employer Employers @relation(fields: [isEmployerId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([isEmployerId])
}

model ReportJob {
  id           String   @id @default(cuid())
  userId       String
  userName     String?
  isWorkerID   String
  jobId        String
  jobName      String
  companyPhone String
  companyEmail String
  companyId    String
  sorted       Boolean  @default(false)
  employerName String
  subject      String
  report       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  worker Workers @relation(fields: [isWorkerID], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([isWorkerID])
}

model ContactEmployer {
  id               String   @id @default(cuid())
  adminUserId      String
  employerUserId   String
  employerUserName String?
  isEmployerID     String
  isAdminID        String
  role             String
  employerHide     Boolean  @default(false)
  employerArchive  Boolean  @default(false)
  adminArchive     Boolean  @default(false)
  adminHide        Boolean  @default(false)
  companyId        String
  adminName        String
  replyingToID     String?
  subject          String
  message          String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  employer Employers @relation(fields: [isEmployerID], references: [id], onDelete: Cascade, onUpdate: Cascade)
  admin    Admin     @relation(fields: [isAdminID], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([isEmployerID])
  @@index([isAdminID])
}

model ContactWorker {
  id             String   @id @default(cuid())
  adminUserId    String
  workerUserId   String
  workerUserName String?
  isWorkerID     String
  isAdminID      String
  role           String
  workerHide     Boolean  @default(false)
  workerArchive  Boolean  @default(false)
  adminArchive   Boolean  @default(false)
  adminHide      Boolean  @default(false)
  adminName      String
  replyingToID   String?
  subject        String
  message        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  worker Workers @relation(fields: [isWorkerID], references: [id], onDelete: Cascade, onUpdate: Cascade)
  admin  Admin   @relation(fields: [isAdminID], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([isWorkerID])
  @@index([isAdminID])
}

model EmployerContactWorker {
  id              String   @id @default(cuid())
  employerUserId  String
  workerUserId    String
  workerUserName  String?
  isWorkerID      String
  isEmployerID    String
  role            String
  workerHide      Boolean  @default(false)
  workerArchive   Boolean  @default(false)
  employerArchive Boolean  @default(false)
  employerHide    Boolean  @default(false)
  companyId       String
  employerName    String
  replyingToID    String?
  subject         String
  message         String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  employer Employers @relation(fields: [isEmployerID], references: [id], onDelete: Cascade, onUpdate: Cascade)
  worker   Workers   @relation(fields: [isWorkerID], references: [id], onDelete: Cascade, onUpdate: Cascade)
  adminId  String?

  @@index([isEmployerID])
  @@index([isWorkerID])
}

model EmployerMessageCandidate {
  id             String   @id @default(cuid())
  userId         String
  userName       String?
  isEmployerID   String
  isWorkerID     String
  receiverUserId String
  receiverName   String?
  companyId      String
  companyName    String?
  jobId          String
  applicationID  String
  jobTitle       String?
  hide           Boolean  @default(false)
  subject        String
  message        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  employer Employers @relation(fields: [isEmployerID], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([isEmployerID])
}

model CareerWizard {
  id                 String   @id @default(cuid())
  userId             String
  isWorkerID         String
  jobId              String
  jobCategory        String
  useGeneratedResume Boolean  @default(true)
  vacancies          String
  jobName            String
  userName           String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  worker Workers @relation(fields: [isWorkerID], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([isWorkerID])
}

model About {
  id         String   @id @default(cuid())
  userId     String   @unique
  isWorkerID String
  about      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  worker Workers @relation(fields: [isWorkerID], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([isWorkerID])
}

model Skills {
  id         String   @id @default(cuid())
  userId     String
  isWorkerID String
  skills     String[] @default([])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  worker Workers @relation(fields: [isWorkerID], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([isWorkerID])
}

model Resume {
  id         String   @id @default(cuid())
  userId     String   @unique
  isWorkerID String
  resume     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  worker Workers @relation(fields: [isWorkerID], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([isWorkerID])
}

model CertificationLicense {
  id                     String   @id @default(cuid())
  userId                 String
  isWorkerID             String
  certificateLicenseName String
  validForever           Boolean? @default(false)
  validStartMonth        String?
  validStartYear         String?
  validEndMonth          String?
  validEndYear           String?
  description            String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  worker Workers @relation(fields: [isWorkerID], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([isWorkerID])
}

model Assessment {
  id                  String   @id @default(cuid())
  bannerID            String
  name                String
  scenarioExplanation String?
  scenario            String?  @db.Text
  category            String
  question            String
  choice1             String
  choice2             String
  choice3             String
  attemptType         String
  answer              String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  assessmentBanner AssessmentBanner @relation(fields: [bannerID], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([bannerID])
}

model AssessmentBanner {
  id              String       @id @default(cuid())
  name            String
  category        String
  briefSummary    String
  numberQuestions Int
  completeTime    Int
  instructions    String?      @db.Text
  attemptNumbers  String
  forDemo         Boolean      @default(false)
  forPublic       Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  Assessment      Assessment[]
}

model InitiateReportAssessmentProblem {
  id                      String                    @id @default(cuid())
  userId                  String
  isWorkerID              String
  questionID              String
  initiateTime            DateTime
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  ReportAssessmentProblem ReportAssessmentProblem[]
}

model ReportAssessmentProblem {
  id                 String   @id @default(cuid())
  userId             String
  initiateID         String
  fullName           String
  email              String
  assessmentName     String
  assessmentCategory String
  isWorkerID         String
  questionID         String
  sorted             Boolean  @default(false)
  subject            String
  report             String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  initiateReportAssessment InitiateReportAssessmentProblem @relation(fields: [initiateID], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([initiateID])
}

enum AssessmentStatus {
  PENDING
  UNINITIATED
  INITIATED
  INCOMPLETE
  REVIEWING
  PASSED
  FAILED
}

model AcceptToBeAssessed {
  id             String           @id @default(cuid())
  isWorkerID     String
  userId         String
  fullName       String
  testName       String
  myAttempts     Int              @default(0)
  testCategory   String
  completeTime   DateTime
  acceptBeTested Boolean          @default(false)
  new            Boolean          @default(true)
  testId         String
  status         AssessmentStatus @default(UNINITIATED)
  score          Int              @default(0)
  attemptType    String           @default("firstAttempt")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  worker         Workers          @relation(fields: [isWorkerID], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([isWorkerID])
}

enum DemoStatus {
  PENDING
  INCOMPLETE
  REVIEWING
  PASSED
  FAILED
}

model EmployerRequestAssessment {
  id           String     @id @default(cuid())
  userId       String
  demoID       String
  completeTime DateTime
  isEmployerID String
  email        String
  phoneNumber  String
  fullName     String
  category     String
  companyName  String
  score        Int        @default(0)
  status       DemoStatus @default(PENDING)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  employer Employers @relation(fields: [isEmployerID], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([isEmployerID])
}

model SubmitTest {
  id          String   @id @default(cuid())
  isWorkerID  String
  userId      String
